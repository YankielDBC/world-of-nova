{
  "name": "world-of-nova",
  "version": "1.0.0",
  "description": "World of Nova - RPG Telegram Bot. Nightfall Patch v1.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run web:dev\"",
    "server:dev": "tsx watch src/server/start.ts",
    "server:start": "tsx src/server/start.ts",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "vite build --config vite.config.ts",
    "dev:bot": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start:bot": "tsx src/index.ts",
    "start:worker": "tsx src/worker.ts",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "format": "prettier --write src/",
    "test": "npm run lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:all": "tsx prisma/seed-resources.ts && tsx prisma/seed-bags.ts && tsx prisma/seed-equipment.ts && tsx prisma/seed-places.ts && tsx prisma/seed-world.ts",
    "db:seed:places": "tsx prisma/seed-places.ts",
    "db:seed:world": "tsx prisma/seed-world.ts",
    "db:seed:resources": "tsx prisma/seed-resources.ts",
    "db:seed:bags": "tsx prisma/seed-bags.ts",
    "db:seed:equipment": "tsx prisma/seed-equipment.ts"
  },
  "prisma": {
    "seed": "npm run db:seed:all"
  },
  "keywords": [
    "telegram",
    "bot",
    "rpg",
    "game"
  ],
  "author": "YankielDBC",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "grammy": "^1.21.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "prisma": "^6.19.2",
    "redis": "^4.7.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.16",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  }
}
